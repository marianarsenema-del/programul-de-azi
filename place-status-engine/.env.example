# copiază acest fișier în ".env" și completează valorile reale
# NU urca niciodată fișierul ".env" (cu valorile reale) pe GitHub

# vine automat din Vercel Storage → baza ta Postgres → Environment Variables
# (dacă folosești alt furnizor - Neon, Supabase, Railway - pune URL-ul lor aici,
# la DATABASE_URL în loc de POSTGRES_URL)
POSTGRES_URL=postgres://utilizator:parola@host/baza?sslmode=require

DB_TABLE=locatii

GOOGLE_PLACES_API_KEY=cheia_ta_de_la_google_cloud_console

# Notificări push — generate o singură dată, local, cu:
#   npx web-push generate-vapid-keys
# Pui aceleași chei și în Vercel (Environment Variables), NU doar aici local.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@programul-de-azi.ro

# opționale — au deja valori implicite rezonabile în cod
RATE_LIMIT_MS=200
BATCH_SIZE=100
LIMIT_TOTAL=20
PLACE_CACHE_TTL_HOURS=12
